RewriteEngine On

# Disable mod_dir's automatic trailing-slash redirect for directories.
# Without this, /api/properties gets a 301 redirect to /api/properties/
# before rewrite rules run, causing the subdirectory index.php to be
# served directly (bypassing the ApiRouter bootstrap in this file).
DirectorySlash Off

# Route ALL requests (including directory paths) to the main API router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php [QSA,L]
