# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=real_estate_platform
DB_USER=root
DB_PASSWORD=

# Application Configuration
# For PRODUCTION (TrueHost), set these to your live domain:
#   BASE_URL=https://yourdomain.com/backend
#   FRONTEND_URL=https://yourdomain.com
#   SESSION_SECURE=true
#   ALLOWED_ORIGINS=https://yourdomain.com
BASE_URL=http://localhost/homes/backend
FRONTEND_URL=http://localhost:5173
SESSION_NAME=real_estate_session
SESSION_LIFETIME=1440
# Set to true once HTTPS is enabled on the live domain
SESSION_SECURE=false
# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Configuration (used as fallback)
# IMPORTANT: replace with a long random string in production (run: openssl rand -base64 48)
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY=7d

# Upload Configuration (10GB max size in MB: 10240)
UPLOAD_MAX_SIZE=10240
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp,avif,svg,pdf,doc,docx,xls,xlsx,txt,mp4,webm,mov,avi,mkv,mp3,wav

# SMTP Configuration (optional - for email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_NAME=Prime Realty Kenya
SMTP_FROM_EMAIL=info@realestate.co.ke

# Google Maps API (optional)
GOOGLE_MAPS_API_KEY=
