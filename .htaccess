Options -Indexes

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ----------------------------------------------------------------------
  # 1. Do not rewrite existing files, directories, or backend routes
  # ----------------------------------------------------------------------
  # /backend/ and /dist/ are handled by PHP / served as-is
  RewriteRule ^backend(/.*)?$ - [L]
  RewriteRule ^dist(/.*)?$ - [L]

  # ----------------------------------------------------------------------
  # 2. Return 404 for missing static assets (prevents SPA fallback from
  #    serving index.html as a replacement, which would cause MIME mismatches)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|json|webmanifest|svg|png|jpg|jpeg|webp|avif|ico|woff|woff2|ttf|eot|map|txt|xml)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # ----------------------------------------------------------------------
  # 3. Serve existing files and directories directly
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------
  # 4. SPA fallback for client-side routes (React Router)
  # ----------------------------------------------------------------------
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>
  <Files "manifest.webmanifest">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  <FilesMatch "\.(js|mjs|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Permissions-Policy: do not send unsupported directives (attribution-reporting)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

